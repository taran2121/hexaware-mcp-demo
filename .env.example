# Copy this file to .env and fill it in. .env is git-ignored; never commit it.
# The agent reads .env at start-up; values here win over anything set in the terminal.

# Required for the Claude brain. Leave empty to use only the offline planner.
ANTHROPIC_API_KEY=

# Optional overrides
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium

# Jira (Atlassian MCP server). Not secrets: sign-in is OAuth via the Connect button,
# and the token is saved in .secrets/ (git-ignored), never here.
JIRA_SITE=your-site.atlassian.net
JIRA_PROJECT=YOURKEY
JIRA_ISSUE_TYPE=Bug
